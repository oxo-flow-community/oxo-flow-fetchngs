# oxo-flow port of nf-core/fetchngs 1.12.0
# (https://github.com/nf-core/fetchngs, commit 8ec2d934f9301c818d961b1e4fdf7fc79610bdc5)
#
# Default-parameters main execution path: samplesheet check -> ENA metadata
# fetch -> FastQ download (FTP, download_method = 'ftp') -> auto-created
# samplesheet + id mappings + MultiQC mappings config.
#
# The alternative download branches are ported as when-gated rules, all off
# by default (download_method = 'ftp', matching upstream):
#   - 'sratools'  -> sra_prefetch + sra_fastq_sratools (prefetch/fasterq-dump
#                    incl. the .sralite variant, sra-tools 3.0.8 / 2.11.0)
#   - 'aspera'    -> sra_fastq_aspera (Aspera CLI 4.14.0, ENA fasp links)
#   - per-run sratools fallback (upstream `branch` triage: with
#     download_method = 'ftp', runs without FTP/fasp links go to
#     prefetch/fasterq-dump) -> sra_prefetch_fallback +
#     sra_fastq_sratools_fallback, gated on sra_tools_fallback = true
#   - dbGaP (--dbgap_key) -> sra_prefetch_dbgap + sra_fastq_sratools_dbgap,
#     gated on dbgap_key being set; the certificate is passed through
#     verbatim (--ngc/--perm), the port itself needs no credentials
# The nf-core boilerplate (versions.yml collection, PIPELINE_COMPLETION
# emails/summary/hooks) stays excluded — see the fidelity table in README.md.

[workflow]
name = "fetchngs"
version = "1.12.0"
description = "Fetch metadata and raw FastQ files from public databases (SRA/ENA/DDBJ/GEO) - oxo-flow port of nf-core/fetchngs"
author = "oxo-flow-community"

[config]
# File containing SRA/ENA/GEO/DDBJ identifiers, one per line (upstream --input).
# Keep in sync with the [[sample_groups]] list below: check_ids validates this
# file, the sample source drives the per-id expansion. Add extra ids on the
# CLI with `oxo-flow run main.oxoflow --sample <ID>`.
input = "test/fixtures/ids.txt"
out_dir = "results"
# Comma-separated ENA metadata fields; empty = upstream default field list.
ena_metadata_fields = ""
# Download method, one of 'ftp' (upstream default), 'sratools' or 'aspera'.
# Each method gates its own branch of download rules; the default 'ftp'
# plan is unchanged when the other branches are off.
download_method = "ftp"
skip_fastq_download = false
# Per-run sra-tools fallback (upstream SRA workflow `branch`): with
# download_method = 'ftp', runs whose ENA metadata has NEITHER an FTP link
# (fastq_1) NOR a fasp link (fastq_aspera) are routed to prefetch +
# fasterq-dump at runtime. Ported as a when-gated branch, off by default so
# the default 'ftp' plan stays byte-identical; enable to match upstream's
# default per-run triage.
sra_tools_fallback = false
# dbGaP authorized-access certificate for the sratools branch (upstream
# --dbgap_key): path to a .ngc or .jwt file. Empty = public data only — the
# public sratools branch works without it; when set, the certificate is
# passed through verbatim (prefetch/fasterq-dump --ngc or --perm).
dbgap_key = ""
# nf-core pipeline to tailor the samplesheet for (rnaseq/atacseq/taxprofiler); empty = none.
nf_core_pipeline = ""
nf_core_rnaseq_strandedness = "auto"
sample_mapping_fields = "experiment_accession,run_accession,sample_accession,experiment_alias,run_alias,sample_alias,experiment_title,sample_title,sample_description"

# One sample source for the default path (playbook §2.4): the database ids.
[[sample_groups]]
name = "ids"
samples = ["SRR9984183", "DRR028935", "ERR1160846"]

# ---------------------------------------------------------------------------
# Samplesheet / input check (upstream PIPELINE_INITIALISATION: isSraId)
# ---------------------------------------------------------------------------
[[rules]]
name = "check_ids"
description = "Validate the input ids file against the SRA/ENA/DDBJ/GEO accession regex and deduplicate"
input = ["{config.input}"]
output = ["{config.out_dir}/pipeline_info/input_ids.txt"]
shell = "python scripts/check_ids.py {input} {output[0]}"
required = true
target = true

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# Metadata fetch (upstream SRA_IDS_TO_RUNINFO)
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_ids_to_runinfo"
description = "Fetch ENA run metadata for the database id into a tab-delimited runinfo file"
input = []
# Upstream gates every downstream step on the validated id list
# (PIPELINE_INITIALISATION feeds the channel). Declare the ordering
# explicitly: id validation must complete before any per-id fetch starts.
depends_on = ["check_ids"]
output = ["{config.out_dir}/metadata/{sample}.runinfo.tsv"]
shell = """
# Per-sample temp file: the docker workdir is shared across concurrent
# rules, and a fixed `id.txt` let parallel id rules clobber each other
# (live: all three runinfo tsvs held the same id's row).
echo {sample} > ".id_{sample}.txt"
metadata_fields=""
if [ -n "{config.ena_metadata_fields}" ]; then
    metadata_fields="--ena_metadata_fields {config.ena_metadata_fields}"
fi
python scripts/sra_ids_to_runinfo.py ".id_{sample}.txt" {output[0]} $metadata_fields
rm -f ".id_{sample}.txt"
"""
retries = 2

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# Parse run info, create file with FTP links (upstream SRA_RUNINFO_TO_FTP)
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_runinfo_to_ftp"
description = "Parse the runinfo file into per-run rows with FTP download links and md5 sums"
input = ["{config.out_dir}/metadata/{sample}.runinfo.tsv"]
output = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
shell = "python scripts/sra_runinfo_to_ftp.py {input} {output[0]}"

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# FastQ download via FTP (upstream SRA_FASTQ_FTP, download_method = 'ftp')
#
# One row per run in the runinfo_ftp.tsv; single-end writes <id>.fastq.gz,
# paired-end writes <id>_1.fastq.gz + <id>_2.fastq.gz (id = <experiment>_<run>).
# Each download is validated against the ENA md5 sum. wget flags, ordering and
# file naming are byte-identical to the upstream process.
#
# No outputs are declared on purpose: the produced file set (single- vs
# paired-end, per-run names) is data-dependent, so it cannot be expressed as
# exact output patterns; the md5sum verification inside the command is the
# correctness gate (as upstream).
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_ftp"
description = "Download FastQ files for each run via FTP and verify ENA md5 sums"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "ftp"'
shell = """
set -eu
tsv="{input}"
fastq_dir="{config.out_dir}/fastq"
md5_dir="$fastq_dir/md5"
mkdir -p "$fastq_dir" "$md5_dir"

# Resolve column indices from the header (default ENA metadata fields)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_id=$(col_of id)
c_fq1=$(col_of fastq_1)
c_fq2=$(col_of fastq_2)
c_md51=$(col_of md5_1)
c_md52=$(col_of md5_2)
c_se=$(col_of single_end)

# One row per run: download each FastQ file and verify its md5sum
tail -n +2 "$tsv" | while read -r line; do
    run_id=$(printf '%s' "$line" | cut -f "$c_id")
    fq1=$(printf '%s' "$line" | cut -f "$c_fq1")
    md51=$(printf '%s' "$line" | cut -f "$c_md51")
    if [ -z "$fq1" ]; then
        echo "WARNING: no FTP link for ${run_id}; upstream would route this run to the per-run sra-tools fallback (not expressible in oxo-flow), skipping" >&2
        continue
    fi
    # Download only when the file is absent or fails its md5 (idempotent
    # re-runs; live: wget -c appended corrupt proxy data to a complete
    # staged file and the subsequent md5 check failed).
    fetch_verified() {
        url="$1"
        out="$2"
        expected="$3"
        base=$(basename "$out")
        if [ -f "$out" ] && printf '%s  %s\n' "$expected" "$base" | (cd "$fastq_dir" && md5sum -c - > /dev/null 2>&1); then
            return 0
        fi
        wget -t 5 -nv -c -T 60 -O "$out" "$url" || exit 1
        printf '%s  %s\n' "$expected" "$base" > "$md5_dir/${base}.md5"
        (cd "$fastq_dir" && md5sum -c "md5/${base}.md5") || exit 1
    }
    se=$(printf '%s' "$line" | cut -f "$c_se")
    if [ "$se" = "true" ]; then
        fetch_verified "$fq1" "$fastq_dir/${run_id}.fastq.gz" "$md51"
    else
        fq2=$(printf '%s' "$line" | cut -f "$c_fq2")
        md52=$(printf '%s' "$line" | cut -f "$c_md52")
        fetch_verified "$fq1" "$fastq_dir/${run_id}_1.fastq.gz" "$md51"
        fetch_verified "$fq2" "$fastq_dir/${run_id}_2.fastq.gz" "$md52"
    fi
done
"""
retries = 2

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/wget:1.20.1"

# ---------------------------------------------------------------------------
# SRA-tools download path (upstream CUSTOM_SRATOOLSNCBISETTINGS +
# SRATOOLS_PREFETCH, download_method = 'sratools')
#
# Upstream routes runs WITHOUT FTP links to sra-tools per run at runtime;
# the explicit `--download_method sratools` mode sends ALL runs here, which
# is what this when-gated branch implements. The per-run fallback itself is
# ported as a when-gated branch (sra_prefetch_fallback +
# sra_fastq_sratools_fallback, off by default via sra_tools_fallback = false
# so the default plan is unchanged); without it, ftp-method runs without
# FTP links are skipped with a warning (see sra_fastq_ftp). Prefetch writes
# <run_accession>.sra / .sralite into results/sra/<id>/ (upstream publishDir
# results/sra, enabled: false — the files are intermediates for
# fasterq-dump only). The NCBI settings file (fresh GUID, upstream
# CUSTOM_SRATOOLSNCBISETTINGS) is written per sample because the docker
# workdir is shared across concurrent rules.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_prefetch"
description = "Prefetch SRA records with sra-tools and validate them with vdb-validate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
# The dbgap variant (sra_prefetch_dbgap) takes over when a certificate is
# configured; both branches evaluate to skipped in the default config, so
# the default plan is unchanged.
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key == ""'
shell = """
set -eu
tsv="{input}"
sra_dir="{config.out_dir}/sra/{sample}"
mkdir -p "$sra_dir"

# Upstream CUSTOM_SRATOOLSNCBISETTINGS: fresh NCBI user settings with a GUID
# and cloud identity reporting; per-sample file name (shared docker workdir)
guid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s%N)
printf '/LIBS/GUID = "%s"\\n/libs/cloud/report_instance_identity = "true"\\n' "$guid" > ".ncbi_{sample}.mkfg"
export NCBI_SETTINGS="$PWD/.ncbi_{sample}.mkfg"

# Resolve column indices from the header (default ENA metadata fields)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_run=$(col_of run_accession)

# Upstream prefetch retry policy: 5 attempts, 1 s base delay, 100 s max
source scripts/retry_with_backoff.sh

# One row per run: prefetch the SRA record, then validate it. The retry
# helper manages failed attempts itself, so `set -e` is disabled around the
# call and the captured status is checked explicitly.
tail -n +2 "$tsv" | while read -r line; do
    run=$(printf '%s' "$line" | cut -f "$c_run")
    if [ -z "$run" ]; then
        echo "WARNING: row without run_accession skipped" >&2
        continue
    fi
    (
        cd "$sra_dir"
        set +e
        retry_with_backoff 5 1 100 prefetch "$run"
        prefetch_status=$?
        set -e
        if [ "$prefetch_status" -ne 0 ]; then
            echo "prefetch failed for $run after retries" >&2
            exit "$prefetch_status"
        fi
        if [ -f "$run.sralite" ]; then
            vdb-validate "$run.sralite"
        else
            vdb-validate "$run"
        fi
    )
done
"""
retries = 2

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/sra-tools:3.0.8--h9f5acd7_0"

# ---------------------------------------------------------------------------
# fasterq-dump + pigz (upstream SRATOOLS_FASTERQDUMP, download_method =
# 'sratools')
#
# Converts the prefetched SRA records into compressed FastQ with the
# upstream naming (`<id>.fastq.gz` single-end, `<id>_1.fastq.gz` +
# `<id>_2.fastq.gz` paired, id = <experiment>_<run>) — identical to the FTP
# branch — and moves them into results/fastq/. fasterq-dump runs in a
# per-run temp dir so concurrent rule instances in the shared docker workdir
# cannot cross-talk (pigz would otherwise glob another instance's fastq).
# Same no-outputs convention as sra_fastq_ftp: the produced file set is
# data-dependent.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_sratools"
description = "Convert prefetched SRA records to compressed FastQ with fasterq-dump and pigz"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
depends_on = ["sra_prefetch"]
# As with sra_prefetch: the dbgap variant takes over when a certificate is
# configured; skipped in the default config, so the default plan is unchanged.
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key == ""'
shell = """
set -eu
tsv="{input}"
sra_dir="{config.out_dir}/sra/{sample}"
fastq_dir="{config.out_dir}/fastq"
mkdir -p "$fastq_dir"

# Fresh NCBI settings as in sra_prefetch (fasterq-dump requires them too)
guid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s%N)
printf '/LIBS/GUID = "%s"\\n/libs/cloud/report_instance_identity = "true"\\n' "$guid" > ".ncbi_{sample}.mkfg"
export NCBI_SETTINGS="$PWD/.ncbi_{sample}.mkfg"

# Resolve column indices from the header (default ENA metadata fields)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_id=$(col_of id)
c_run=$(col_of run_accession)
c_se=$(col_of single_end)

# One row per run: fasterq-dump the prefetched record, compress with pigz
tail -n +2 "$tsv" | while read -r line; do
    run_id=$(printf '%s' "$line" | cut -f "$c_id")
    run=$(printf '%s' "$line" | cut -f "$c_run")
    se=$(printf '%s' "$line" | cut -f "$c_se")
    if [ -z "$run" ]; then
        echo "WARNING: no run accession for ${run_id}; skipping" >&2
        continue
    fi
    sra_file="$sra_dir/$run.sra"
    [ -f "$sra_file" ] || sra_file="$sra_dir/$run.sralite"
    if [ ! -f "$sra_file" ]; then
        echo "ERROR: prefetched SRA file for ${run} not found in $sra_dir" >&2
        exit 1
    fi
    d=".fd_{sample}_${run}"
    mkdir -p "$d"
    (
        cd "$d"
        if [ "$se" = "true" ]; then
            fasterq-dump --split-files --include-technical --threads 2 --outfile "${run_id}.fastq" "$sra_file"
        else
            fasterq-dump --split-files --include-technical --threads 2 --outfile "$run_id" "$sra_file"
        fi
        pigz --no-name --processes 2 ./*.fastq
        mv ./*.fastq.gz "$fastq_dir/"
    )
    rm -rf "$d"
done
"""
retries = 2

[rules.resources]
threads = 2
memory = "8G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-5f89fe0cd045cb1d615630b9261a1d17943a9b6a:6a9ff0e76ec016c3d0d27e0c0d362339f2d787e6-0"

# ---------------------------------------------------------------------------
# Per-run sra-tools fallback (upstream SRA workflow `branch`, download_method
# = 'ftp' + sra_tools_fallback = true)
#
# Upstream triages each run at runtime: with download_method = 'ftp', runs
# whose metadata has NEITHER an FTP link (fastq_1) NOR a fasp link
# (fastq_aspera) are sent to prefetch + fasterq-dump per run (branch
# condition `!meta.fastq_aspera && !meta.fastq_1`). oxo-flow cannot branch
# per row, so the triage is ported as a when-gated branch off by default:
# when enabled, these two rules prefetch exactly that subset (the shared
# scripts re-derive it from the runinfo tsv) and the FTP rule keeps
# downloading the runs that do have links. Same no-outputs convention as the
# sratools-method branch: intermediates land in results/sra/{sample}/, the
# produced fastq set is data-dependent.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_prefetch_fallback"
description = "Prefetch SRA records for runs without FTP/fasp links (upstream per-run sratools fallback) and validate them with vdb-validate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "ftp" && config.sra_tools_fallback'
shell = "bash scripts/sra_prefetch_runs.sh --fallback \"{input}\" \"{config.out_dir}/sra/{sample}\""
retries = 2

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/sra-tools:3.0.8--h9f5acd7_0"

[[rules]]
name = "sra_fastq_sratools_fallback"
description = "Convert prefetched SRA records of fallback runs to compressed FastQ with fasterq-dump and pigz"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
depends_on = ["sra_prefetch_fallback"]
when = '!config.skip_fastq_download && config.download_method == "ftp" && config.sra_tools_fallback'
shell = "bash scripts/sra_fastq_sratools_runs.sh --fallback \"{input}\" \"{config.out_dir}/sra/{sample}\" \"{config.out_dir}/fastq\""
retries = 2

[rules.resources]
threads = 2
memory = "8G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-5f89fe0cd045cb1d615630b9261a1d17943a9b6a:6a9ff0e76ec016c3d0d27e0c0d362339f2d787e6-0"

# ---------------------------------------------------------------------------
# dbGaP branch (upstream --dbgap_key, download_method = 'sratools' +
# dbgap_key set)
#
# Controlled-access SRA data needs an NIH dbGaP authorized-access
# certificate (.ngc or .jwt file) supplied by the USER at runtime — the
# port itself needs no credentials and the public sratools branch is
# unchanged. When dbgap_key is set, these two rules take over from
# sra_prefetch / sra_fastq_sratools (which are gated off in that case) and
# pass the certificate through verbatim exactly like upstream: prefetch
# `--ngc`/`--perm` (SRATOOLS_PREFETCH shell logic) and
# fasterq-dump `--ngc`/`--perm` (SRATOOLS_FASTERQDUMP script logic).
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_prefetch_dbgap"
description = "Prefetch SRA records with a dbGaP authorized-access certificate and validate them with vdb-validate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key != ""'
shell = "bash scripts/sra_prefetch_runs.sh \"{input}\" \"{config.out_dir}/sra/{sample}\" \"{config.dbgap_key}\""
retries = 2

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/sra-tools:3.0.8--h9f5acd7_0"

[[rules]]
name = "sra_fastq_sratools_dbgap"
description = "Convert prefetched SRA records to compressed FastQ with fasterq-dump and pigz, using a dbGaP authorized-access certificate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
depends_on = ["sra_prefetch_dbgap"]
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key != ""'
shell = "bash scripts/sra_fastq_sratools_runs.sh \"{input}\" \"{config.out_dir}/sra/{sample}\" \"{config.out_dir}/fastq\" \"{config.dbgap_key}\""
retries = 2

[rules.resources]
threads = 2
memory = "8G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-5f89fe0cd045cb1d615630b9261a1d17943a9b6a:6a9ff0e76ec016c3d0d27e0c0d362339f2d787e6-0"

# ---------------------------------------------------------------------------
# Aspera download path (upstream ASPERA_CLI, download_method = 'aspera')
#
# Downloads via the ENA fasp links with the Aspera CLI shipped in the pinned
# biocontainer (anonymous `era-fasp` user + pre-installed bypass key — no
# credentials; the image is the same upstream uses). ascp flags
# `-QT -l 300m -P33001` from the upstream module config. Upstream also sends
# runs without fasp links to the ftp / sra-tools branches per run; oxo-flow
# cannot branch per-row, so such runs are skipped with a warning (deviation,
# see README).
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_aspera"
description = "Download FastQ files for each run via ENA fasp links with Aspera CLI and verify ENA md5 sums"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "aspera"'
shell = """
set -eu
tsv="{input}"
fastq_dir="{config.out_dir}/fastq"
md5_dir="$fastq_dir/md5"
mkdir -p "$fastq_dir" "$md5_dir"

# Resolve column indices from the header (default ENA metadata fields;
# fastq_aspera is part of the upstream default field list)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_id=$(col_of id)
c_fasp=$(col_of fastq_aspera)
c_md51=$(col_of md5_1)
c_md52=$(col_of md5_2)
c_se=$(col_of single_end)

# One row per run: download each FastQ file over fasp and verify its md5sum
tail -n +2 "$tsv" | while read -r line; do
    run_id=$(printf '%s' "$line" | cut -f "$c_id")
    fasp=$(printf '%s' "$line" | cut -f "$c_fasp")
    md51=$(printf '%s' "$line" | cut -f "$c_md51")
    if [ -z "$fasp" ]; then
        echo "WARNING: no fasp link for ${run_id}; upstream would fall back to the ftp/sra-tools branches, skipping" >&2
        continue
    fi
    # Download only when the file is absent or fails its md5 (idempotent
    # re-runs, same pattern as the ftp branch)
    fetch_verified() {
        url="$1"
        out="$2"
        expected="$3"
        base=$(basename "$out")
        if [ -f "$out" ] && printf '%s  %s\\n' "$expected" "$base" | (cd "$fastq_dir" && md5sum -c - > /dev/null 2>&1); then
            return 0
        fi
        rm -f "$out"
        ascp -QT -l 300m -P33001 -i /usr/local/etc/aspera/aspera_bypass_dsa.pem "era-fasp@$url" "$out" || exit 1
        printf '%s  %s\\n' "$expected" "$base" > "$md5_dir/${base}.md5"
        (cd "$fastq_dir" && md5sum -c "md5/${base}.md5") || exit 1
    }
    fasp1=$(printf '%s' "$line" | cut -f "$c_fasp" | cut -d';' -f1)
    fasp2=$(printf '%s' "$line" | cut -f "$c_fasp" | cut -d';' -f2)
    se=$(printf '%s' "$line" | cut -f "$c_se")
    if [ "$se" = "true" ]; then
        fetch_verified "$fasp1" "$fastq_dir/${run_id}.fastq.gz" "$md51"
    else
        md52=$(printf '%s' "$line" | cut -f "$c_md52")
        fetch_verified "$fasp1" "$fastq_dir/${run_id}_1.fastq.gz" "$md51"
        fetch_verified "$fasp2" "$fastq_dir/${run_id}_2.fastq.gz" "$md52"
    fi
done
"""
retries = 2

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/aspera-cli:4.14.0--hdfd78af_1"

# ---------------------------------------------------------------------------
# Auto-create samplesheet + id mappings (upstream SRA_TO_SAMPLESHEET)
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_to_samplesheet"
description = "Create a samplesheet row per run and the sample-id mappings file"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = [
    "{config.out_dir}/samplesheet/{sample}.samplesheet.csv",
    "{config.out_dir}/samplesheet/{sample}.mappings.csv",
]
# Exactly one of the download branch sets is active per run (download_method
# + sra_tools_fallback/dbgap_key); the others are skipped and skipped rules
# satisfy dependencies, so listing all of them is safe. The samplesheet must
# wait for every branch: whichever one runs produces the fastq files the
# sheet references (all branches use the same file naming).
depends_on = [
    "sra_fastq_ftp",
    "sra_fastq_sratools",
    "sra_fastq_aspera",
    "sra_prefetch_fallback",
    "sra_fastq_sratools_fallback",
    "sra_prefetch_dbgap",
    "sra_fastq_sratools_dbgap",
]
when = "!config.skip_fastq_download"
shell = "python scripts/sra_to_samplesheet.py \"{input}\" \"{output[0]}\" \"{output[1]}\" \"{config.out_dir}\" \"{config.nf_core_pipeline}\" \"{config.nf_core_rnaseq_strandedness}\" \"{config.sample_mapping_fields}\""
localrule = true

[rules.resources]
threads = 1
memory = "100M"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# Merge per-id samplesheets into the final samplesheet
# (upstream `collectFile(name:'samplesheet.csv', storeDir: outdir/samplesheet)`)
# ---------------------------------------------------------------------------
[[rules]]
name = "combine_samplesheets"
description = "Concatenate per-id samplesheets (header once) into the final samplesheet.csv"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/samplesheet/{sample}.samplesheet.csv", variables = { sample = "config.samples_list" } }
]
output = ["{config.out_dir}/samplesheet/samplesheet.csv"]
depends_on = ["sra_to_samplesheet"]
when = "!config.skip_fastq_download"
target = true
shell = """
set -eu
out={output[0]}
mkdir -p {config.out_dir}/samplesheet
files=$(echo {input} | tr ' ' '\\n' | sort)
if [ -z "$files" ]; then
    : > "$out"
else
    first=1
    for f in $files; do
        if [ "$first" -eq 1 ]; then
            cat "$f" > "$out"
            first=0
        else
            tail -n +2 "$f" >> "$out"
        fi
    done
fi
"""

[rules.resources]
threads = 1
memory = "1G"

# ---------------------------------------------------------------------------
# Merge per-id mappings into id_mappings.csv
# (upstream `collectFile(name:'id_mappings.csv', storeDir: outdir/samplesheet)`)
# ---------------------------------------------------------------------------
[[rules]]
name = "combine_mappings"
description = "Concatenate per-id mappings files (header once) into the final id_mappings.csv"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/samplesheet/{sample}.mappings.csv", variables = { sample = "config.samples_list" } }
]
output = ["{config.out_dir}/samplesheet/id_mappings.csv"]
depends_on = ["sra_to_samplesheet"]
when = "!config.skip_fastq_download"
shell = """
set -eu
out={output[0]}
mkdir -p {config.out_dir}/samplesheet
files=$(echo {input} | tr ' ' '\\n' | sort)
if [ -z "$files" ]; then
    : > "$out"
else
    first=1
    for f in $files; do
        if [ "$first" -eq 1 ]; then
            cat "$f" > "$out"
            first=0
        else
            tail -n +2 "$f" >> "$out"
        fi
    done
fi
"""

[rules.resources]
threads = 1
memory = "1G"

# ---------------------------------------------------------------------------
# MultiQC config with sample name mappings (upstream MULTIQC_MAPPINGS_CONFIG)
# ---------------------------------------------------------------------------
[[rules]]
name = "multiqc_mappings_config"
description = "Create a MultiQC config file with sample name mappings"
input = ["{config.out_dir}/samplesheet/id_mappings.csv"]
output = ["{config.out_dir}/samplesheet/multiqc_config.yml"]
when = 'config.sample_mapping_fields != ""'
target = true
shell = "python scripts/multiqc_mappings_config.py {input} {output[0]}"

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"
