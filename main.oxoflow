# oxo-flow port of nf-core/fetchngs 1.13.0
# (https://github.com/nf-core/fetchngs, commit 955c892d80927cee633765e6e390f9cc6b7235c9)
#
# Default-parameters main execution path: samplesheet check -> ENA metadata
# fetch -> FastQ download (FTP, download_method = 'ftp') -> auto-created
# samplesheet + id mappings + MultiQC mappings config.
#
# The alternative download branches are ported as when-gated rules, all off
# by default (download_method = 'ftp', matching upstream):
#   - 'sratools'  -> sra_prefetch + sra_fastq_sratools (prefetch/fasterq-dump
#                    with sra-tools 3.2.1 — per-run prefetch directories +
#                    vdb-validate/md5 integrity — and fasterq-dump 3.2.1 with
#                    the 1.13.0 --outfile <id>.fastq + "exclude third file"
#                    handling, pigz 2.8)
#   - 'aspera'    -> sra_fastq_aspera (Aspera CLI 4.20.0, ENA fasp links; the
#                    ascp client is downloaded at runtime via
#                    `ascli conf ascp install` and the RSA bypass key is the
#                    upstream asset assets/aspera_bypass_rsa.pem)
#   - 'fastq-dl'  -> sra_fastq_fastqdl (fastq-dl 4.0.1 via ENA's own mirrors;
#                    upstream also triages runs without download links to
#                    prefetch/fasterq-dump for this method — the sra-tools
#                    fallback rules carry that triage)
#   - per-run fallback (upstream `branch` triage, gated on
#     sra_tools_fallback = true): with download_method = 'ftp', runs without
#     FTP/fasp links go to prefetch/fasterq-dump -> sra_prefetch_fallback +
#     sra_fastq_sratools_fallback; with download_method = 'aspera', runs
#     without a fasp link go to the FTP branch when they have an FTP link
#     (sra_fastq_ftp_aspera_fallback) and to prefetch/fasterq-dump
#     otherwise (the same fallback rules — their when-gates cover both
#     methods)
#   - dbGaP (--dbgap_key) -> sra_prefetch_dbgap + sra_fastq_sratools_dbgap,
#     gated on dbgap_key being set; the certificate is passed through
#     verbatim (--ngc/--perm), the port itself needs no credentials; like
#     upstream, a configured certificate is also honoured on the per-run
#     triage branches (upstream passes params.dbgap_key to the sratools
#     subworkflow for every download method)
# The nf-core boilerplate (versions.yml collection) stays excluded — see the
# fidelity table in README.md. PIPELINE_COMPLETION (completion email, failure
# email) is ported onto the workflow-level terminal hooks below (engine >=
# 0.17.0; unknown [workflow] keys on older engines are ignored, so the
# released-engine default plan is unchanged). Upstream 1.13.0 dropped the
# hook_url / imNotification webhook feature, so this port has no webhook
# branch either.
# The hooks are best-effort and no-op by default: they fire only when
# [config] email / email_on_fail are set (see below).

[workflow]
name = "fetchngs"
version = "1.13.0"
description = "Fetch metadata and raw FastQ files from public databases (SRA/ENA/DDBJ/GEO) - oxo-flow port of nf-core/fetchngs"
author = "oxo-flow-community"
# nf-core PIPELINE_COMPLETION (workflow.onComplete / workflow.onError, 1.13.0)
# -> engine terminal hooks: on_complete fires once after a run with no failed
# rules, on_error after a run with at least one failure (including
# --keep-going runs). Both render {config.*} and the {succeeded}/{failed}/
# {skipped} counters, run in the workflow root with the workflow shell_prelude,
# and never change the run status (best-effort). scripts/pipeline_completion.sh
# does the guarded sendmail/mail work, echoes the upstream onError
# troubleshooting note on failed runs, and always exits 0. Upstream 1.13.0
# removed the hook_url / imNotification webhook branch together with this port.
on_complete = 'bash scripts/pipeline_completion.sh completed "{config.email}" "{config.email_on_fail}" {succeeded} {failed} {skipped} {config.out_dir}'
on_error = 'bash scripts/pipeline_completion.sh failed "{config.email}" "{config.email_on_fail}" {succeeded} {failed} {skipped} {config.out_dir}'

[config]
# File containing SRA/ENA/GEO/DDBJ identifiers, one per line (upstream --input).
# Keep in sync with the [[sample_groups]] list below: check_ids validates this
# file, the sample source drives the per-id expansion. Add extra ids on the
# CLI with `oxo-flow run main.oxoflow --sample <ID>`.
input = "test/fixtures/ids.txt"
out_dir = "results"
# Comma-separated ENA metadata fields; empty = upstream default field list.
ena_metadata_fields = ""
# Download method, one of 'ftp' (upstream default), 'sratools', 'aspera' or
# 'fastq-dl' (upstream 1.13.0: fastq-dl queries ENA directly and downloads
# from ENA's own mirrors, bypassing NCBI/SRA endpoints).
# Each method gates its own branch of download rules; the default 'ftp'
# plan is unchanged when the other branches are off.
download_method = "ftp"
skip_fastq_download = false
# Per-run fallback (upstream SRA workflow `branch`), off by default so the
# default 'ftp' plan stays byte-identical; enable to match upstream's
# per-run triage for both methods:
#   - download_method = 'ftp': runs whose ENA metadata has NEITHER an FTP
#     link (fastq_1) NOR a fasp link (fastq_aspera) are routed to prefetch
#     + fasterq-dump at runtime (sra_prefetch_fallback +
#     sra_fastq_sratools_fallback);
#   - download_method = 'aspera': runs without a fasp link are routed to
#     the FTP branch when they have an FTP link (fastq_1,
#     sra_fastq_ftp_aspera_fallback) and to prefetch + fasterq-dump
#     otherwise (the same fallback rules).
# Without it, such runs are skipped with a warning. With
# download_method = 'fastq-dl' the triage runs UNCONDITIONALLY (upstream
# 1.13.0 routes runs without download links to the sratools subworkflow for
# every method): the same two fallback rules carry it regardless of this
# toggle.
sra_tools_fallback = false
# dbGaP authorized-access certificate for the sratools branch (upstream
# --dbgap_key): path to a .ngc or .jwt file. Empty = public data only — the
# public sratools branch works without it; when set, the certificate is
# passed through verbatim (prefetch/fasterq-dump --ngc or --perm).
# Declared sensitive so the value is env-routed and never lands in plaintext
# in command records, logs, or the checkpoint (lint W032).
dbgap_key = { default = "", sensitive = true }
# nf-core pipeline to tailor the samplesheet for (upstream 1.13.0 schema
# enum: ampliseq / atacseq / mag / metatdenovo / rnaseq / sarek / taxprofiler /
# viralrecon; metatdenovo and viralrecon add no extra columns); empty = none.
nf_core_pipeline = ""
nf_core_rnaseq_strandedness = "auto"
sample_mapping_fields = "experiment_accession,run_accession,sample_accession,experiment_alias,run_alias,sample_alias,experiment_title,sample_title,sample_description"
# Completion notifications (upstream PIPELINE_COMPLETION, --email /
# --email_on_fail; upstream defaults are null, here ""):
#   - email          address the completion summary is mailed to (sendmail/mail
#                    on the host) after a run without failed rules
#   - email_on_fail  address mailed after a failed run; falls back to `email`
#                    when empty (nf-core sends the failure mail to email_on_fail,
#                    or to email when only that is set)
# Upstream 1.13.0 removed --hook_url / imNotification (the webhook JSON-card
# path and its assets/adaptivecard.json + assets/slackreport.json payloads
# were dropped), so there is no webhook branch here either; the upstream
# workflow.onError troubleshooting note is echoed by the hook script.
# These drive the [workflow] on_complete / on_error hooks above (engine >=
# 0.17.0). With both empty (the default) both hooks are no-ops, matching
# upstream's null params; older engines ignore the [workflow] keys entirely.
# sraCurateSamplesheetWarn (the upstream end-of-run "double-check the
# samplesheet" log note) has no hook: the auto-created samplesheet curation
# caveat is documented in README.md instead.
email = ""
email_on_fail = ""

# One sample source for the default path (playbook §2.4): the database ids.
[[sample_groups]]
name = "ids"
samples = ["SRR9984183", "DRR028935", "ERR1160846"]

# ---------------------------------------------------------------------------
# Samplesheet / input check (upstream PIPELINE_INITIALISATION: isSraId)
# ---------------------------------------------------------------------------
[[rules]]
name = "check_ids"
description = "Validate the input ids file against the SRA/ENA/DDBJ/GEO accession regex and deduplicate"
input = ["{config.input}"]
output = ["{config.out_dir}/pipeline_info/input_ids.txt"]
shell = "python scripts/check_ids.py {input} {output[0]}"
required = true
target = true

[rules.resources]
threads = 1
memory = "1G"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# Metadata fetch (upstream SRA_IDS_TO_RUNINFO)
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_ids_to_runinfo"
description = "Fetch ENA run metadata for the database id into a tab-delimited runinfo file"
input = []
# Upstream gates every downstream step on the validated id list
# (PIPELINE_INITIALISATION feeds the channel). Declare the ordering
# explicitly: id validation must complete before any per-id fetch starts.
depends_on = ["check_ids"]
output = ["{config.out_dir}/metadata/{sample}.runinfo.tsv"]
shell = """
# Per-sample temp file: the docker workdir is shared across concurrent
# rules, and a fixed `id.txt` let parallel id rules clobber each other
# (live: all three runinfo tsvs held the same id's row).
echo {sample} > ".id_{sample}.txt"
metadata_args=()
if [ -n "{config.ena_metadata_fields}" ]; then
    # Upstream 1.13.0 SRA_IDS_TO_RUNINFO (nf-core/fetchngs PR 381): quote the
    # list and collapse whitespace around commas so metadata fields with
    # spaces cannot word-split.
    fields=$(printf '%s' "{config.ena_metadata_fields}" | sed 's/[[:space:]]*,[[:space:]]*/,/g')
    metadata_args=(--ena_metadata_fields "$fields")
fi
python scripts/sra_ids_to_runinfo.py ".id_{sample}.txt" {output[0]} "${metadata_args[@]}"
rm -f ".id_{sample}.txt"
"""
retries = 2

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# Parse run info, create file with FTP links (upstream SRA_RUNINFO_TO_FTP)
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_runinfo_to_ftp"
description = "Parse the runinfo file into per-run rows with FTP download links and md5 sums"
input = ["{config.out_dir}/metadata/{sample}.runinfo.tsv"]
output = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
shell = "python scripts/sra_runinfo_to_ftp.py {input} {output[0]}"

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# FastQ download via FTP (upstream SRA_FASTQ_FTP, download_method = 'ftp')
#
# One row per run in the runinfo_ftp.tsv; single-end writes <id>.fastq.gz,
# paired-end writes <id>_1.fastq.gz + <id>_2.fastq.gz (id = <experiment>_<run>).
# Each download is validated against the ENA md5 sum. wget flags, ordering and
# file naming are byte-identical to the upstream process.
#
# No outputs are declared on purpose: the produced file set (single- vs
# paired-end, per-run names) is data-dependent, so it cannot be expressed as
# exact output patterns; the md5sum verification inside the command is the
# correctness gate (as upstream).
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_ftp"
description = "Download FastQ files for each run via FTP and verify ENA md5 sums"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "ftp"'
shell = """
set -eu
tsv="{input}"
fastq_dir="{config.out_dir}/fastq"
md5_dir="$fastq_dir/md5"
mkdir -p "$fastq_dir" "$md5_dir"

# Resolve column indices from the header (default ENA metadata fields)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_id=$(col_of id)
c_fq1=$(col_of fastq_1)
c_fq2=$(col_of fastq_2)
c_md51=$(col_of md5_1)
c_md52=$(col_of md5_2)
c_se=$(col_of single_end)

# One row per run: download each FastQ file and verify its md5sum
tail -n +2 "$tsv" | while read -r line; do
    run_id=$(printf '%s' "$line" | cut -f "$c_id")
    fq1=$(printf '%s' "$line" | cut -f "$c_fq1")
    md51=$(printf '%s' "$line" | cut -f "$c_md51")
    if [ -z "$fq1" ]; then
        echo "WARNING: no FTP link for ${run_id}; handled by the per-run sra-tools fallback (sra_prefetch_fallback) when sra_tools_fallback = true, skipping here" >&2
        continue
    fi
    # Download only when the file is absent or fails its md5 (idempotent
    # re-runs; live: wget -c appended corrupt proxy data to a complete
    # staged file and the subsequent md5 check failed).
    fetch_verified() {
        url="$1"
        out="$2"
        expected="$3"
        base=$(basename "$out")
        if [ -f "$out" ] && printf '%s  %s\n' "$expected" "$base" | (cd "$fastq_dir" && md5sum -c - > /dev/null 2>&1); then
            return 0
        fi
        wget -t 5 -nv -w 5 --random-wait -c -T 60 -O "$out" "$url" || exit 1
        printf '%s  %s\n' "$expected" "$base" > "$md5_dir/${base}.md5"
        (cd "$fastq_dir" && md5sum -c "md5/${base}.md5") || exit 1
    }
    se=$(printf '%s' "$line" | cut -f "$c_se")
    if [ "$se" = "true" ]; then
        fetch_verified "$fq1" "$fastq_dir/${run_id}.fastq.gz" "$md51"
    else
        fq2=$(printf '%s' "$line" | cut -f "$c_fq2")
        md52=$(printf '%s' "$line" | cut -f "$c_md52")
        fetch_verified "$fq1" "$fastq_dir/${run_id}_1.fastq.gz" "$md51"
        fetch_verified "$fq2" "$fastq_dir/${run_id}_2.fastq.gz" "$md52"
    fi
done
"""
retries = 2

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
# Upstream 1.13.0 moved this process from biocontainers/wget:1.20.1 to the
# Seqera Wave image bundling gzip 1.14 + wget 1.25.0 (DNS-resolution fix);
# md5sum comes from the image's coreutils, as before.
docker = "community.wave.seqera.io/library/gzip_wget:041a8ba200c3fa3f"

# ---------------------------------------------------------------------------
# SRA-tools download path (upstream CUSTOM_SRATOOLSNCBISETTINGS +
# SRATOOLS_PREFETCH, download_method = 'sratools')
#
# Upstream routes runs WITHOUT FTP links to sra-tools per run at runtime;
# the explicit `--download_method sratools` mode sends ALL runs here, which
# is what this when-gated branch implements. The per-run fallback itself is
# ported as a when-gated branch (sra_prefetch_fallback +
# sra_fastq_sratools_fallback, off by default via sra_tools_fallback = false
# so the default plan is unchanged); without it, ftp-method runs without
# FTP links are skipped with a warning (see sra_fastq_ftp). Prefetch writes a
# per-run directory results/sra/<id>/<run_accession>/ (upstream 1.13.0:
# sra-tools 3.2.1 prefetch emits ETL directories, output
# path("${id}", type: 'dir'), under the publishDir results/sra, enabled:
# false — the files are intermediates for fasterq-dump only). Integrity is
# checked with vdb-validate and, when the archive carries no checksums, an
# md5 comparison against the NCBI locate endpoint (upstream PR 305). The NCBI
# settings file (fresh GUID, upstream CUSTOM_SRATOOLSNCBISETTINGS) is written
# per sample because the docker workdir is shared across concurrent rules.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_prefetch"
description = "Prefetch SRA records with sra-tools and validate them with vdb-validate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
# The dbgap variant (sra_prefetch_dbgap) takes over when a certificate is
# configured; both branches evaluate to skipped in the default config, so
# the default plan is unchanged.
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key == ""'
shell = """
set -eu
tsv="{input}"
sra_dir="{config.out_dir}/sra/{sample}"
mkdir -p "$sra_dir"

# Upstream CUSTOM_SRATOOLSNCBISETTINGS: fresh NCBI user settings with a GUID
# and cloud identity reporting; per-sample file name (shared docker workdir)
guid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s%N)
printf '/LIBS/GUID = "%s"\\n/libs/cloud/report_instance_identity = "true"\\n' "$guid" > ".ncbi_{sample}.mkfg"
export NCBI_SETTINGS="$PWD/.ncbi_{sample}.mkfg"

# Resolve column indices from the header (default ENA metadata fields)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_run=$(col_of run_accession)

# Upstream prefetch retry policy: 5 attempts, 1 s base delay, 100 s max
source scripts/retry_with_backoff.sh

# One row per run: prefetch the SRA record, then validate it. The retry
# helper manages failed attempts itself, so `set -e` is disabled around the
# call and the captured status is checked explicitly.
tail -n +2 "$tsv" | while read -r line; do
    run=$(printf '%s' "$line" | cut -f "$c_run")
    if [ -z "$run" ]; then
        echo "WARNING: row without run_accession skipped" >&2
        continue
    fi
    (
        cd "$sra_dir"
        # Upstream 1.13.0 SRATOOLS_PREFETCH script block echoes the effective
        # retry policy (args2) and the final prefetch arguments.
        echo "5 1 100"
        echo ""
        set +e
        retry_with_backoff 5 1 100 prefetch "$run"
        prefetch_status=$?
        set -e
        if [ "$prefetch_status" -ne 0 ]; then
            echo "prefetch failed for $run after retries" >&2
            exit "$prefetch_status"
        fi
        # check file integrity using vdb-validate or (when archive contains
        # no checksums) md5sum (upstream 1.13.0 retry_with_backoff.sh; the
        # 1.12.0 .sralite branch is gone — sra-tools 3.2.1 prefetch writes a
        # per-run directory)
        vdb-validate "$run" > vdb-validate_result.txt 2>&1 || exit 1
        if grep -q "checksums missing" vdb-validate_result.txt; then
            VALID_MD5SUMS=$(curl --silent --fail --location --retry 3 --retry-delay 60 "https://locate.ncbi.nlm.nih.gov/sdl/2/retrieve?filetype=run&acc=$run")
            LOCAL_MD5SUMS=$(md5sum "$run"/* | cut -f1 -d' ')
            if ! grep -q -F -f <(echo "$LOCAL_MD5SUMS") <(echo "$VALID_MD5SUMS"); then
                echo "MD5 sum check failed" 1>&2
                exit 1
            fi
        fi
    )
done
"""
retries = 2

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
# sra-tools 3.2.1 (upstream 1.13.0 pin; the conda env additionally carries
# curl for the md5 integrity fallback, PR 305)
docker = "quay.io/biocontainers/sra-tools:3.2.1--h4304569_1"

# ---------------------------------------------------------------------------
# fasterq-dump + pigz (upstream SRATOOLS_FASTERQDUMP, download_method =
# 'sratools')
#
# Converts the prefetched SRA records (per-run directories written by
# sra-tools 3.2.1) into compressed FastQ with the upstream 1.13.0 naming:
# `--outfile <id>.fastq` for both layouts (`--split-files` yields
# `<id>.fastq_1/_2` for paired runs; id = <experiment>_<run>), the paired
# "third file" moved aside by the upstream `mv $outfile $prefix || echo 'No
# third file'` guard — the workaround for the '.'-in-path bug
# (ncbi/sra-tools#865) — then pigz. Files land in results/fastq/ and the
# samplesheet references the actual per-branch file names (see
# sra_to_samplesheet). fasterq-dump runs in a per-run temp dir so concurrent
# rule instances in the shared docker workdir cannot cross-talk (pigz would
# otherwise glob another instance's fastq). Same no-outputs convention as
# sra_fastq_ftp: the produced file set is data-dependent.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_sratools"
description = "Convert prefetched SRA records to compressed FastQ with fasterq-dump and pigz"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
depends_on = ["sra_prefetch"]
# As with sra_prefetch: the dbgap variant takes over when a certificate is
# configured; skipped in the default config, so the default plan is unchanged.
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key == ""'
shell = """
set -eu
tsv="{input}"
sra_dir="{config.out_dir}/sra/{sample}"
fastq_dir="{config.out_dir}/fastq"
mkdir -p "$fastq_dir"

# Fresh NCBI settings as in sra_prefetch (fasterq-dump requires them too)
guid=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || date +%s%N)
printf '/LIBS/GUID = "%s"\\n/libs/cloud/report_instance_identity = "true"\\n' "$guid" > ".ncbi_{sample}.mkfg"
export NCBI_SETTINGS="$PWD/.ncbi_{sample}.mkfg"

# Resolve column indices from the header (default ENA metadata fields)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_id=$(col_of id)
c_run=$(col_of run_accession)
c_se=$(col_of single_end)

# One row per run: fasterq-dump the prefetched record, compress with pigz
tail -n +2 "$tsv" | while read -r line; do
    run_id=$(printf '%s' "$line" | cut -f "$c_id")
    run=$(printf '%s' "$line" | cut -f "$c_run")
    se=$(printf '%s' "$line" | cut -f "$c_se")
    if [ -z "$run" ]; then
        echo "WARNING: no run accession for ${run_id}; skipping" >&2
        continue
    fi
    sra_file="$sra_dir/$run"
    if [ ! -d "$sra_file" ]; then
        echo "ERROR: prefetched SRA directory for ${run} not found in $sra_dir" >&2
        exit 1
    fi
    d=".fd_{sample}_${run}"
    mkdir -p "$d"
    (
        cd "$d"
        # Upstream 1.13.0 SRATOOLS_FASTERQDUMP: the outfile is always
        # <prefix>.fastq; for paired-end runs the "third file" (the outfile
        # itself) is moved out of pigz' *.fastq glob — the workaround for the
        # '.'-in-path bug (ncbi/sra-tools#865).
        outfile="${run_id}.fastq"
        fasterq-dump --split-files --include-technical --threads 2 --outfile "$outfile" "$sra_file"
        if [ "$se" != "true" ]; then
            mv "$outfile" "$run_id" || echo 'No third file'
        fi
        pigz --no-name --processes 2 ./*.fastq
        mv ./*.fastq.gz "$fastq_dir/"
    )
    rm -rf "$d"
done
"""
retries = 2

[rules.resources]
threads = 2
memory = "8G"
time_limit = "4h"

[rules.environment]
# Upstream 1.13.0 replaced the patched mulled image (sra-tools 2.11.0 + pigz
# 2.6) with the Seqera Wave image sra-tools 3.2.1 + pigz 2.8 (the module's
# local sratools-fasterqdump.diff patch is gone).
docker = "community.wave.seqera.io/library/sra-tools_pigz:4a694d823f6f7fcf"

# ---------------------------------------------------------------------------
# fastq-dl download path (upstream FASTQDL module, download_method =
# 'fastq-dl', added in nf-core/fetchngs 1.13.0, PR 353/395)
#
# fastq-dl queries ENA directly and downloads from ENA's own mirrors,
# bypassing the NCBI/SRA endpoints (upstream module docs). The upstream
# module runs `fastq-dl ${ext.args} --prefix <meta.id> --accession
# <run_accession> --cpus <task.cpus> --outdir .` — ext.args is unset for
# this process (no withName block adds it), so no extra flags. The tool's
# own output names are carried into the samplesheet (see sra_to_samplesheet:
# `<run>[_1|_2].fastq.gz`), and the module's publishDirs stage
# `<meta.id>-run-info.tsv` (+ the paired-run `<meta.id>-run-mergers.tsv`,
# upstream output optional: true) into the metadata dir — replicated by the
# moves below. Upstream's `branch` routes every run that has an FTP or fasp
# link here under this method; runs without either link go to the sratools
# subworkflow — the when-gated sra_prefetch_fallback /
# sra_fastq_sratools_fallback rules carry that triage unconditionally for
# this method (their filter skips exactly the rows this rule processes).
# No outputs declared on purpose (data-dependent file set, same convention as
# the other download rules); the fastq-dl tool's own checksum verification is
# the integrity gate — upstream adds no md5sum pass for this branch.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_fastqdl"
description = "Download FastQ files per run with fastq-dl from the ENA mirrors and stage the run-info/mergers tables"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "fastq-dl"'
shell = """
set -eu
tsv="{input}"
fastq_dir="{config.out_dir}/fastq"
meta_dir="{config.out_dir}/metadata"
mkdir -p "$fastq_dir" "$meta_dir"

# Resolve column indices from the header (default ENA metadata fields)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_id=$(col_of id)
c_run=$(col_of run_accession)
c_fq1=$(col_of fastq_1)
c_fasp=$(col_of fastq_aspera)

# One row per run: runs without both download links are triaged to the
# sratools fallback rules (upstream branch), everything else goes to fastq-dl
tail -n +2 "$tsv" | while read -r line; do
    run_id=$(printf '%s' "$line" | cut -f "$c_id")
    run=$(printf '%s' "$line" | cut -f "$c_run")
    fq1=$(printf '%s' "$line" | cut -f "$c_fq1")
    fasp=$(printf '%s' "$line" | cut -f "$c_fasp")
    if [ -z "$fq1" ] && [ -z "$fasp" ]; then
        echo "WARNING: no FTP/fasp link for ${run_id}; handled by the per-run sratools fallback (sra_prefetch_fallback + sra_fastq_sratools_fallback), skipping here" >&2
        continue
    fi
    if [ -z "$run" ]; then
        echo "WARNING: no run accession for ${run_id}; skipping" >&2
        continue
    fi
    d=".fdl_{sample}_${run}"
    mkdir -p "$d"
    (
        cd "$d"
        # Upstream FASTQDL script block (task.ext.args empty for this process)
        fastq-dl \\
            --prefix ${run_id} \\
            --accession ${run} \\
            --cpus 2 \\
            --outdir .
        mv ./*.fastq.gz "$fastq_dir/"
        mv ${run_id}-run-info.tsv "$meta_dir/"
        if [ -f ${run_id}-run-mergers.tsv ]; then
            mv ${run_id}-run-mergers.tsv "$meta_dir/"
        fi
    )
    rm -rf "$d"
done
"""
# Upstream FASTQDL carries no error_retry label; the base config retries
# once on infrastructure exit statuses -> port-side equivalent retries = 1.
retries = 1

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
# Upstream 1.13.0 FASTQDL pin (Seqera Wave, fastq-dl 4.0.1, PR 395)
docker = "community.wave.seqera.io/library/fastq-dl:4.0.1--fd5420f75c055a44"

# ---------------------------------------------------------------------------
# Per-run sra-tools fallback (upstream SRA workflow `branch`, download_method
# = 'ftp' / 'aspera' + sra_tools_fallback = true; for download_method =
# 'fastq-dl' the same two rules carry the upstream triage unconditionally)
#
# Upstream triages each run at runtime: runs whose metadata has NEITHER an
# FTP link (fastq_1) NOR a fasp link (fastq_aspera) are sent to prefetch +
# fasterq-dump per run (branch condition `!meta.fastq_aspera && !meta.fastq_1`)
# — for download_method = 'ftp', 'aspera' AND 'fastq-dl' alike. oxo-flow
# cannot branch per row, so the triage is ported as when-gated branches:
# off by default for 'ftp'/'aspera' (plan-stable), on by default for
# 'fastq-dl'. When enabled, these two rules prefetch exactly that subset (the
# shared scripts re-derive it from the runinfo tsv) and the FTP rule keeps
# downloading the runs that do have links; under 'aspera' the FTP-link-but-
# no-fasp subset is downloaded by sra_fastq_ftp_aspera_fallback. Like
# upstream (which passes params.dbgap_key to the sratools subworkflow for
# every method), a configured dbGaP certificate flows into the triage too —
# the public path (empty dbgap_key) is unchanged. Same no-outputs convention
# as the sratools-method branch: intermediates land in
# results/sra/{sample}/ (per-run directories with sra-tools 3.2.1), the
# produced fastq set is data-dependent.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_prefetch_fallback"
description = "Prefetch SRA records for runs without FTP/fasp links (upstream per-run sratools fallback) and validate them with vdb-validate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && (((config.download_method == "ftp" || config.download_method == "aspera") && config.sra_tools_fallback) || config.download_method == "fastq-dl")'
shell = "bash scripts/sra_prefetch_runs.sh --fallback \"{input}\" \"{config.out_dir}/sra/{sample}\" \"{config.dbgap_key}\""
retries = 2

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/sra-tools:3.2.1--h4304569_1"

[[rules]]
name = "sra_fastq_sratools_fallback"
description = "Convert prefetched SRA records of fallback runs to compressed FastQ with fasterq-dump and pigz"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
depends_on = ["sra_prefetch_fallback"]
when = '!config.skip_fastq_download && (((config.download_method == "ftp" || config.download_method == "aspera") && config.sra_tools_fallback) || config.download_method == "fastq-dl")'
shell = "bash scripts/sra_fastq_sratools_runs.sh --fallback \"{input}\" \"{config.out_dir}/sra/{sample}\" \"{config.out_dir}/fastq\" \"{config.dbgap_key}\""
retries = 2

[rules.resources]
threads = 2
memory = "8G"
time_limit = "4h"

[rules.environment]
docker = "community.wave.seqera.io/library/sra-tools_pigz:4a694d823f6f7fcf"

# ---------------------------------------------------------------------------
# dbGaP branch (upstream --dbgap_key, download_method = 'sratools' +
# dbgap_key set)
#
# Controlled-access SRA data needs an NIH dbGaP authorized-access
# certificate (.ngc or .jwt file) supplied by the USER at runtime — the
# port itself needs no credentials and the public sratools branch is
# unchanged. When dbgap_key is set, these two rules take over from
# sra_prefetch / sra_fastq_sratools (which are gated off in that case) and
# pass the certificate through verbatim exactly like upstream: prefetch
# `--ngc`/`--perm` (SRATOOLS_PREFETCH shell logic) and
# fasterq-dump `--ngc`/`--perm` (SRATOOLS_FASTERQDUMP script logic).
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_prefetch_dbgap"
description = "Prefetch SRA records with a dbGaP authorized-access certificate and validate them with vdb-validate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key != ""'
shell = "bash scripts/sra_prefetch_runs.sh \"{input}\" \"{config.out_dir}/sra/{sample}\" \"{config.dbgap_key}\""
retries = 2

[rules.resources]
threads = 1
memory = "2G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/sra-tools:3.2.1--h4304569_1"

[[rules]]
name = "sra_fastq_sratools_dbgap"
description = "Convert prefetched SRA records to compressed FastQ with fasterq-dump and pigz, using a dbGaP authorized-access certificate"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
depends_on = ["sra_prefetch_dbgap"]
when = '!config.skip_fastq_download && config.download_method == "sratools" && config.dbgap_key != ""'
shell = "bash scripts/sra_fastq_sratools_runs.sh \"{input}\" \"{config.out_dir}/sra/{sample}\" \"{config.out_dir}/fastq\" \"{config.dbgap_key}\""
retries = 2

[rules.resources]
threads = 2
memory = "8G"
time_limit = "4h"

[rules.environment]
docker = "community.wave.seqera.io/library/sra-tools_pigz:4a694d823f6f7fcf"

# ---------------------------------------------------------------------------
# Aspera download path (upstream ASPERA_CLI, download_method = 'aspera')
#
# Downloads via the ENA fasp links with the Aspera CLI shipped in the pinned
# biocontainer (anonymous `era-fasp` user — no credentials; the image is the
# same upstream uses). Upstream 1.13.0 BREAKING change (PR 398/399): aspera-
# cli moved 4.14.0 -> 4.20.0 and the image no longer bundles the ascp
# client — the command bootstraps it at runtime via `ascli conf ascp install`
# (the upstream per-process script header, executed once per rule here), so
# the compute node needs outbound internet; and the bypass key switched from
# the in-image DSA key to the RSA asset assets/aspera_bypass_rsa.pem (DSA is
# deprecated), shipped here byte-identical to the upstream module asset.
# ascp args `-QT -l 300m -P33001` from the upstream module config. Upstream
# also sends runs without fasp links to the ftp / sra-tools branches per
# run; that triage is ported as when-gated branches
# (sra_fastq_ftp_aspera_fallback + sra_prefetch_fallback /
# sra_fastq_sratools_fallback, all on sra_tools_fallback = true); without
# it, such runs are skipped with a warning (deviation, see README).
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_aspera"
description = "Download FastQ files for each run via ENA fasp links with Aspera CLI and verify ENA md5 sums"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "aspera"'
shell = """
set -eu

# Upstream ASPERA_CLI 1.13.0 script header: the 4.20.0 image no longer ships
# ascp; download it at runtime (idempotent) and locate the binary. The RSA
# bypass key is the upstream module asset (DSA key deprecated).
export GEM_HOME="${GEM_HOME:-/usr/local/share/rubygems}"
if [ ! -w "${HOME:-/}" ]; then
    export HOME=$(mktemp -d)
fi
if [ ! -d "${HOME}/.aspera/sdk" ]; then
    ascli conf ascp install 1>&2
fi
ASCP=$(find "${HOME}/.aspera/sdk" -name "ascp" -type f | head -1)
BYPASS_KEY="assets/aspera_bypass_rsa.pem"

tsv="{input}"
fastq_dir="{config.out_dir}/fastq"
md5_dir="$fastq_dir/md5"
mkdir -p "$fastq_dir" "$md5_dir"

# Resolve column indices from the header (default ENA metadata fields;
# fastq_aspera is part of the upstream default field list)
header=$(head -n 1 "$tsv")
col_of() {
    printf '%s\\n' "$header" | tr '\\t' '\\n' | grep -nx "$1" | cut -d: -f1
}
c_id=$(col_of id)
c_fasp=$(col_of fastq_aspera)
c_md51=$(col_of md5_1)
c_md52=$(col_of md5_2)
c_se=$(col_of single_end)

# One row per run: download each FastQ file over fasp and verify its md5sum
tail -n +2 "$tsv" | while read -r line; do
    run_id=$(printf '%s' "$line" | cut -f "$c_id")
    fasp=$(printf '%s' "$line" | cut -f "$c_fasp")
    md51=$(printf '%s' "$line" | cut -f "$c_md51")
    if [ -z "$fasp" ]; then
        echo "WARNING: no fasp link for ${run_id}; upstream routes this run to the ftp/sra-tools branches per run — ported as sra_fastq_ftp_aspera_fallback + sra_prefetch_fallback when sra_tools_fallback = true, skipping here" >&2
        continue
    fi
    # Download only when the file is absent or fails its md5 (idempotent
    # re-runs, same pattern as the ftp branch)
    fetch_verified() {
        url="$1"
        out="$2"
        expected="$3"
        base=$(basename "$out")
        if [ -f "$out" ] && printf '%s  %s\\n' "$expected" "$base" | (cd "$fastq_dir" && md5sum -c - > /dev/null 2>&1); then
            return 0
        fi
        rm -f "$out"
        # Upstream 1.13.0 invokes the runtime-installed client with the RSA
        # bypass key (upstream script: `"$ASCP" ${args} -i "$BYPASS_KEY" ...`)
        "$ASCP" -QT -l 300m -P33001 -i "$BYPASS_KEY" "era-fasp@$url" "$out" || exit 1
        printf '%s  %s\\n' "$expected" "$base" > "$md5_dir/${base}.md5"
        (cd "$fastq_dir" && md5sum -c "md5/${base}.md5") || exit 1
    }
    fasp1=$(printf '%s' "$line" | cut -f "$c_fasp" | cut -d';' -f1)
    fasp2=$(printf '%s' "$line" | cut -f "$c_fasp" | cut -d';' -f2)
    se=$(printf '%s' "$line" | cut -f "$c_se")
    if [ "$se" = "true" ]; then
        fetch_verified "$fasp1" "$fastq_dir/${run_id}.fastq.gz" "$md51"
    else
        md52=$(printf '%s' "$line" | cut -f "$c_md52")
        fetch_verified "$fasp1" "$fastq_dir/${run_id}_1.fastq.gz" "$md51"
        fetch_verified "$fasp2" "$fastq_dir/${run_id}_2.fastq.gz" "$md52"
    fi
done
"""
retries = 2

[rules.resources]
threads = 1
memory = "4G"
time_limit = "4h"

[rules.environment]
# aspera-cli 4.20.0--hdfd78af_0 (upstream 1.13.0 pin; conda env
# bioconda::aspera-cli=4.20.0). ascp itself arrives at runtime via the
# script header above — the image only carries the ascli bootstrapper.
docker = "quay.io/biocontainers/aspera-cli:4.20.0--hdfd78af_0"

# ---------------------------------------------------------------------------
# Per-run FTP fallback for the aspera method (upstream SRA workflow
# `branch`, download_method = 'aspera' + sra_tools_fallback = true)
#
# Upstream triages each run at runtime regardless of the download method:
# with download_method = 'aspera', runs that have an FTP link (fastq_1) but
# no fasp link (fastq_aspera) are sent to the FTP process per run (branch
# condition `meta.fastq_1 && !meta.fastq_aspera`). Ported as a when-gated
# branch (same toggle as the sra-tools fallback), off by default so the
# default plan is unchanged: when enabled, the shared script partitions the
# runinfo tsv with the aspera and sra-tools rules — every run is downloaded
# exactly once, by whichever branch upstream's `branch` would pick. Same
# no-outputs convention as sra_fastq_ftp / sra_fastq_aspera: the produced
# file set is data-dependent; the md5sum verification inside the command is
# the correctness gate.
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_fastq_ftp_aspera_fallback"
description = "Download via FTP the runs without a fasp link (upstream per-run ftp fallback under download_method = 'aspera') and verify ENA md5 sums"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = []
when = '!config.skip_fastq_download && config.download_method == "aspera" && config.sra_tools_fallback'
shell = "bash scripts/sra_fastq_ftp_aspera_runs.sh \"{input}\" \"{config.out_dir}\""
retries = 2

[rules.resources]
threads = 2
memory = "12G"
time_limit = "4h"

[rules.environment]
# Same Seqera Wave gzip+wget image as sra_fastq_ftp (upstream 1.13.0)
docker = "community.wave.seqera.io/library/gzip_wget:041a8ba200c3fa3f"

# ---------------------------------------------------------------------------
# Auto-create samplesheet + id mappings (upstream SRA_TO_SAMPLESHEET in
# 1.12.0; in 1.13.0 the logic lives in the CHANNEL_SRA_CREATE_CSV
# subworkflow's buildPipelineMap + the per-run FastQ-name rewrite in
# workflows/fetchngs.nf)
# ---------------------------------------------------------------------------
[[rules]]
name = "sra_to_samplesheet"
description = "Create a samplesheet row per run and the sample-id mappings file"
input = ["{config.out_dir}/metadata/{sample}.runinfo_ftp.tsv"]
output = [
    "{config.out_dir}/samplesheet/{sample}.samplesheet.csv",
    "{config.out_dir}/samplesheet/{sample}.mappings.csv",
]
# Exactly one of the download branch sets is active per run (download_method
# + sra_tools_fallback/dbgap_key); the others are skipped and skipped rules
# satisfy dependencies, so listing all of them is safe. The samplesheet must
# wait for every branch: whichever one runs produces the fastq files the
# sheet references (the file naming follows the upstream 1.13.0 `branch`
# closure per run — see scripts/sra_to_samplesheet.py).
depends_on = [
    "sra_fastq_ftp",
    "sra_fastq_sratools",
    "sra_fastq_fastqdl",
    "sra_fastq_aspera",
    "sra_fastq_ftp_aspera_fallback",
    "sra_prefetch_fallback",
    "sra_fastq_sratools_fallback",
    "sra_prefetch_dbgap",
    "sra_fastq_sratools_dbgap",
]
when = "!config.skip_fastq_download"
shell = "python scripts/sra_to_samplesheet.py \"{input}\" \"{output[0]}\" \"{output[1]}\" \"{config.out_dir}\" \"{config.nf_core_pipeline}\" \"{config.nf_core_rnaseq_strandedness}\" \"{config.sample_mapping_fields}\" \"{config.download_method}\""
localrule = true

[rules.resources]
threads = 1
memory = "100M"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"

# ---------------------------------------------------------------------------
# Merge per-id samplesheets into the final samplesheet
# (upstream `collectFile(name:'samplesheet.csv', storeDir: outdir/samplesheet)`)
# ---------------------------------------------------------------------------
[[rules]]
name = "combine_samplesheets"
description = "Concatenate per-id samplesheets (header once) into the final samplesheet.csv"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/samplesheet/{sample}.samplesheet.csv", variables = { sample = "config.samples_list" } }
]
output = ["{config.out_dir}/samplesheet/samplesheet.csv"]
depends_on = ["sra_to_samplesheet"]
when = "!config.skip_fastq_download"
target = true
shell = """
set -eu
out={output[0]}
mkdir -p {config.out_dir}/samplesheet
files=$(echo {input} | tr ' ' '\\n' | sort)
if [ -z "$files" ]; then
    : > "$out"
else
    # Upstream CHANNEL_SRA_CREATE_CSV (1.13.0): collectFile(newLine: true,
    # keepHeader: true, sort: true) — the header is kept once and the value
    # rows are sorted lexicographically (Groovy natural String order = byte
    # order; the per-id files all carry the identical header, so sorting the
    # collected "header\\nvalues" strings reduces to sorting the value rows).
    head -n 1 $(echo "$files" | head -n 1) > "$out"
    for f in $files; do
        tail -n +2 "$f"
    done | LC_ALL=C sort >> "$out"
fi
"""

[rules.resources]
threads = 1
memory = "1G"

# ---------------------------------------------------------------------------
# Merge per-id mappings into id_mappings.csv
# (upstream `collectFile(name:'id_mappings.csv', storeDir: outdir/samplesheet)`)
# ---------------------------------------------------------------------------
[[rules]]
name = "combine_mappings"
description = "Concatenate per-id mappings files (header once) into the final id_mappings.csv"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/samplesheet/{sample}.mappings.csv", variables = { sample = "config.samples_list" } }
]
output = ["{config.out_dir}/samplesheet/id_mappings.csv"]
depends_on = ["sra_to_samplesheet"]
when = "!config.skip_fastq_download"
shell = """
set -eu
out={output[0]}
mkdir -p {config.out_dir}/samplesheet
files=$(echo {input} | tr ' ' '\\n' | sort)
if [ -z "$files" ]; then
    : > "$out"
else
    # Upstream CHANNEL_SRA_CREATE_CSV (1.13.0): collectFile(newLine: true,
    # keepHeader: true, sort: true) — header kept once, value rows sorted
    # lexicographically (see the combine_samplesheets note).
    head -n 1 $(echo "$files" | head -n 1) > "$out"
    for f in $files; do
        tail -n +2 "$f"
    done | LC_ALL=C sort >> "$out"
fi
"""

[rules.resources]
threads = 1
memory = "1G"

# ---------------------------------------------------------------------------
# MultiQC config with sample name mappings (upstream MULTIQC_MAPPINGS_CONFIG)
# ---------------------------------------------------------------------------
[[rules]]
name = "multiqc_mappings_config"
description = "Create a MultiQC config file with sample name mappings"
input = ["{config.out_dir}/samplesheet/id_mappings.csv"]
output = ["{config.out_dir}/samplesheet/multiqc_config.yml"]
when = 'config.sample_mapping_fields != ""'
target = true
shell = "python scripts/multiqc_mappings_config.py {input} {output[0]}"

[rules.resources]
threads = 1
memory = "6G"
time_limit = "4h"

[rules.environment]
docker = "quay.io/biocontainers/python:3.9--1"
